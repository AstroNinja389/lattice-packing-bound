# Limit the publication tree to certificates and their supporting files.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/manifest.json
!/LICENSE
!/LICENCE
!/certificates/
!/verify/
!/logs/
!/notes/
!/data/
!/paper/
/certificates/*
!/certificates/n[0-9][0-9][0-9].json
/verify/*
!/verify/bernstein.py
!/verify/descartes.py
!/verify/pari.py
!/verify/run.py
!/verify/taylor.py
!/verify/verify.gp
/logs/*
!/logs/bernstein.json
!/logs/descartes.json
!/logs/pari.json
!/logs/taylor.json
/notes/*
!/notes/bernstein-method.md
!/notes/descartes-method.md
!/notes/taylor-method.md
!/notes/verification-contract.md
/data/*
!/data/results.json
/paper/*
!/paper/main.tex
!/paper/main.pdf
